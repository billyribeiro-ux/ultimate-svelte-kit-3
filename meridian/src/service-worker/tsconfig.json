{
	// A service worker runs in its own global scope — `ServiceWorkerGlobalScope`,
	// with `caches`, `clients` and `FetchEvent`, and no `document` — so it is
	// type-checked against the WebWorker library instead of the DOM. SvelteKit
	// generates that base config; the root `tsconfig.json` excludes this folder,
	// and `pnpm run check` runs `tsc -p src/service-worker` with this file.
	"extends": "$app/tsconfig/service-worker",
	"compilerOptions": {
		// The same strictness as the rest of the project (see the root tsconfig).
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"erasableSyntaxOnly": true
	}
}

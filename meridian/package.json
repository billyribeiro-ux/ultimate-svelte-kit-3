{
	"name": "meridian",
	"description": "Meridian — a trip planner for people who travel together: a map, a globe, an itinerary you can drag, notes, expenses split fairly, three languages, a publishable geodesy library, and a second person planning beside you.",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"engines": {
		"node": ">=24.22.0"
	},
	"packageManager": "pnpm@12.14.0",
	"scripts": {
		"dev": "pnpm run build:element && vite dev",
		"build": "pnpm run build:element && vite build",
		"build:element": "vite build --config vite.element.config.ts",
		"preview": "vite preview",
		"start": "node build",
		"prepare": "pnpm run package && pnpm run i18n && svelte-kit sync || echo ''",
		"package": "pnpm --filter @meridian/waypoint run package",
		"i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --emit-ts-declarations --strategy url cookie preferredLanguage baseLocale",
		"check": "pnpm run i18n --silent && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p src/service-worker",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings --watch",
		"lint": "prettier --check . && eslint . && node scripts/contrast.ts",
		"lint:svelte": "node scripts/autofix-report.ts",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"verify": "npm run check && npm run lint && npm run lint:svelte && npm run test:unit -- --run && npm run build && node scripts/bundle-guard.ts && npm run test:e2e",
		"verify:package": "pnpm --filter @meridian/waypoint run verify",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:seed": "node scripts/seed.ts"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.29.0",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/enhanced-img": "^1.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/mcp": "^0.1.26",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^24.19.2",
		"@types/three": "^0.186.0",
		"@types/topojson-client": "^3.1.5",
		"@types/topojson-specification": "^1.0.5",
		"@vitest/browser-playwright": "^5.0.5",
		"axe-core": "^4.14.0",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"mdsvex": "^0.12.8",
		"playwright": "^1.64.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"sharp": "^0.35.5",
		"sv": "^1.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.5",
		"vitest-browser-svelte": "^3.1.0"
	},
	"dependencies": {
		"@fontsource-variable/fraunces": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@libsql/client": "^0.18.0",
		"@meridian/waypoint": "workspace:*",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/core": "^2.12.0",
		"@opentelemetry/sdk-trace-base": "^2.12.0",
		"@opentelemetry/sdk-trace-node": "^2.12.0",
		"@tanstack/svelte-table": "^9.3.1",
		"@threlte/core": "^8.6.1",
		"@threlte/extras": "^9.22.2",
		"@tiptap/core": "^3.32.0",
		"@tiptap/extension-placeholder": "^3.32.0",
		"@tiptap/pm": "^3.32.0",
		"@tiptap/starter-kit": "^3.32.0",
		"better-auth": "^1.7.10",
		"bits-ui": "^2.19.5",
		"drizzle-orm": "^0.45.4",
		"gsap": "^3.15.0",
		"layerchart": "^2.8.1",
		"maplibre-gl": "^6.15.0",
		"phosphor-svelte": "^3.1.1",
		"runed": "^0.37.1",
		"svelte-dnd-action": "^0.9.80",
		"svelte-maplibre": "^2.0.1",
		"svelte-sonner": "^1.2.1",
		"three": "^0.186.1",
		"topojson-client": "^3.1.0",
		"valibot": "^1.5.0",
		"world-atlas": "^2.0.2"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}

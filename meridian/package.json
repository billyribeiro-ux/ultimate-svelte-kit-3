{
	"name": "meridian",
	"description": "Meridian — a trip planner for people who travel together: a map, a globe, an itinerary you can drag, notes, expenses split fairly, three languages, a publishable geodesy library, and a second person planning beside you.",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"engines": {
		"node": ">=24.20.0"
	},
	"packageManager": "pnpm@11.24.0",
	"scripts": {
		"dev": "pnpm run build:element && vite dev",
		"build": "pnpm run build:element && vite build",
		"build:element": "vite build --config vite.element.config.ts",
		"preview": "vite preview",
		"start": "node build",
		"prepare": "pnpm run package && pnpm run i18n && svelte-kit sync || echo ''",
		"package": "pnpm --filter @meridian/waypoint run package",
		"i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --emit-ts-declarations --strategy url cookie preferredLanguage baseLocale",
		"check": "pnpm run i18n --silent && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --compiler-warnings \"options_missing_custom_element:ignore\"",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --compiler-warnings \"options_missing_custom_element:ignore\" --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"verify": "npm run check && npm run lint && npm run test:unit -- --run && npm run build && npm run test:e2e",
		"verify:package": "pnpm --filter @meridian/waypoint run verify",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:seed": "node scripts/seed.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.25.0",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-node": "^6.0.0-next.10",
		"@sveltejs/enhanced-img": "^1.0.0-next.5",
		"@sveltejs/kit": "^3.0.0-next.25",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^24.13.3",
		"@types/three": "^0.185.4",
		"@types/topojson-client": "^3.1.5",
		"@types/topojson-specification": "^1.0.5",
		"@vitest/browser-playwright": "^4.1.11",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"mdsvex": "^0.12.8",
		"playwright": "^1.62.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"sharp": "^0.35.4",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.69.0",
		"vite": "^8.2.2",
		"vitest": "^4.1.11",
		"vitest-browser-svelte": "^3.0.0"
	},
	"dependencies": {
		"@fontsource-variable/fraunces": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@libsql/client": "^0.18.0",
		"@meridian/waypoint": "workspace:*",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/core": "^2.11.0",
		"@opentelemetry/sdk-trace-base": "^2.11.0",
		"@opentelemetry/sdk-trace-node": "^2.11.0",
		"@tanstack/svelte-table": "^9.2.4",
		"@threlte/core": "^8.6.0",
		"@threlte/extras": "^9.21.1",
		"@tiptap/core": "^3.31.0",
		"@tiptap/pm": "^3.31.0",
		"@tiptap/starter-kit": "^3.31.0",
		"better-auth": "^1.7.2",
		"bits-ui": "^2.19.0",
		"drizzle-orm": "^0.45.2",
		"gsap": "^3.15.0",
		"layerchart": "^2.3.1",
		"maplibre-gl": "^6.7.0",
		"phosphor-svelte": "^3.1.0",
		"runed": "^0.37.1",
		"svelte-dnd-action": "^0.9.79",
		"svelte-maplibre": "^2.0.0",
		"svelte-sonner": "^1.2.1",
		"three": "^0.185.1",
		"topojson-client": "^3.1.0",
		"valibot": "^1.4.2",
		"world-atlas": "^2.0.2"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}

{
	"name": "@meridian/waypoint",
	"version": "0.1.0",
	"description": "Geodesy for trip planners: distances, bearings, great-circle routes, a reactive Route class, and two small Svelte components.",
	"license": "MIT",
	"type": "module",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": [
		"**/*.css"
	],
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./geo": {
			"types": "./dist/geo/index.d.ts",
			"default": "./dist/geo/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"prepare": "svelte-kit sync || echo ''",
		"package": "svelte-kit sync && svelte-package",
		"package:check": "publint && attw --pack . --profile esm-only --entrypoints ./geo && attw --pack . --profile esm-only --entrypoints . --ignore-rules internal-resolution-error",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest --run",
		"verify": "npm run check && npm run test && npm run package && npm run package:check"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@sveltejs/kit": "^3.0.0-next.25",
		"@sveltejs/package": "^3.0.0-next.7",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@vitest/browser-playwright": "^4.1.11",
		"playwright": "^1.62.1",
		"publint": "^0.3.24",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "^8.2.2",
		"vitest": "^4.1.11",
		"vitest-browser-svelte": "^3.0.0"
	}
}

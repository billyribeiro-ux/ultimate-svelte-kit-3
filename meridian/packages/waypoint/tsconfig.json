{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,

		/*
		 * `declarationMap` lets an editor jump from a consumer's "Go to
		 * Definition" into the real `.ts` or `.svelte` source rather than the
		 * generated `.d.ts` — provided the source is published beside `dist`,
		 * which `files` in package.json takes care of.
		 */
		"declaration": true,
		"declarationMap": true
	},
	"include": ["src/**/*.ts", "src/**/*.js", "src/**/*.svelte", "*.config.ts"],
	"exclude": ["node_modules", "dist", ".svelte-kit"]
}

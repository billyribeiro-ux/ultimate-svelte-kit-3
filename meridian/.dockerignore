# Everything the build does not need, so the context is small and a stray
# local database or secret can never end up in a layer.
node_modules
packages/*/node_modules
packages/*/dist
packages/*/.svelte-kit
build
.svelte-kit
static/embed
src/lib/paraglide
test-results
playwright-report
coverage
*.db
*.db-shm
*.db-wal
.env
.env.*
!.env.example
.git
.github
.claude
e2e
*.md
Dockerfile
compose.yaml
.dockerignore

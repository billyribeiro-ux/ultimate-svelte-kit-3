# Meridian — copy to `.env` and fill in.

# libSQL. A file for development; a Turso URL plus token in production.
DATABASE_URL=file:local.db

# Where the app is served from, with no trailing slash.
#
# Read at BUILD time as well as at run time (`static: true` in `src/env.ts`):
# `vite.config.ts` substitutes it into `paths.origin` for the CSRF check, and
# Better Auth uses it as its base URL. Set it for the build, not just the process.
PUBLIC_ORIGIN=http://localhost:5173

# Signs Better Auth's session cookies. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-at-least-thirty-two-characters

# The most stops one trip may hold. Keeps a runaway import from turning the
# itinerary page into a scroll bar.
STOP_LIMIT=500

# Dependencies. Restored by `pnpm install` from the lockfile, which *is*
# committed — the lockfile is the source of truth, the folder is a cache.
node_modules/

# Build output.
build/
.svelte-kit/
.vercel/
.output/
packages/*/dist/
apps/*/dist/

# Databases and their write-ahead logs. Regenerated by `pnpm seed`.
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Test and tooling caches.
.vitest/
coverage/
playwright-report/
test-results/
.turbo/
*.tsbuildinfo

# Local environment. `.env.example` is committed; the real one never is.
.env
.env.*
!.env.example

# Editors and operating systems.
.DS_Store
Thumbs.db
*.swp
.idea/

# Scratch files. Anything ending `.tmp.ts` is a throwaway probe.
*.tmp.ts

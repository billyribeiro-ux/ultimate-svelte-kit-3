{
	"name": "sequent",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24.20.0"
	},
	"packageManager": "pnpm@11.24.0",
	"scripts": {
		"build": "pnpm --filter=@sequent/web build",
		"check": "pnpm -r check",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"verify": "pnpm run check && pnpm run test && pnpm run build",
		"seed": "node scripts/seed.js",
		"engine": "pnpm --filter=@sequent/engine start",
		"worker": "pnpm --filter=@sequent/worker start",
		"dev": "node scripts/dev.js"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@types/node": "^24.13.3",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"fast-check": "^4.9.0",
		"globals": "^17.11.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.68.0",
		"vitest": "^4.1.11"
	}
}

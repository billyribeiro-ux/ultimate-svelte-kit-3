{
	"name": "sequent",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24.19.0"
	},
	"packageManager": "pnpm@10.33.0",
	"scripts": {
		"build": "pnpm --filter=@sequent/web build",
		"check": "pnpm -r check",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"verify": "pnpm run check && pnpm run test && pnpm run build",
		"seed": "node scripts/seed.js",
		"engine": "pnpm --filter=@sequent/engine start",
		"dev": "node scripts/dev.js"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@types/node": "^24.10.1",
		"eslint": "^10.1.0",
		"eslint-config-prettier": "^10.1.8",
		"fast-check": "^4.9.0",
		"globals": "^16.5.0",
		"prettier": "^3.6.2",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0",
		"vitest": "^4.1.10"
	}
}

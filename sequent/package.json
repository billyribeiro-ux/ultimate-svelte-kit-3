{
	"name": "sequent",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24.22.0"
	},
	"packageManager": "pnpm@12.14.0",
	"scripts": {
		"build": "pnpm --filter=@sequent/web build",
		"check": "pnpm -r check",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "pnpm --filter=@sequent/web test:e2e",
		"verify": "pnpm run check && pnpm run test && pnpm run build && pnpm run test:e2e",
		"seed": "node scripts/seed.js",
		"engine": "pnpm --filter=@sequent/engine start",
		"worker": "pnpm --filter=@sequent/worker start",
		"dev": "node scripts/dev.js"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^24.19.2",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"fast-check": "^4.10.2",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"vitest": "^5.0.5"
	}
}

{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		/*
		 * Node's globals and module declarations. Named explicitly rather than
		 * left to automatic `@types` discovery, so a package that should NOT see
		 * them — a browser-only one — is a tsconfig away from proving it.
		 */
		"types": ["node"]
	},
	"include": ["src/**/*.ts"]
}

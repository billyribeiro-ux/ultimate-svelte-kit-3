{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		/*
		 * No `types` at all — deliberately.
		 *
		 * The matching engine has no business knowing that Node exists. Without
		 * Node's globals, `process.env`, `Date.now()` via a Node type, `Buffer`
		 * and every filesystem call are type errors here rather than review
		 * comments. The constraint that keeps the engine replayable is enforced
		 * by the compiler, not by discipline.
		 */
		"types": []
	},
	"include": ["src/**/*.ts"]
}

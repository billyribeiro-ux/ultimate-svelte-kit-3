# Copy to `.env` and adjust. `.env` is gitignored; this file is not.
#
# Anything the web app reads must ALSO be declared in `apps/web/src/env.ts`.
# SvelteKit 3 refuses to import a variable that is not declared there, so a
# name that appears only here is a type error rather than a runtime surprise.
#
# The engine and the worker are plain Node processes and read `process.env`
# directly, which is why a few names below have no counterpart in `env.ts`.

# --- Database (libSQL) -------------------------------------------------------
#
# All three processes must open the SAME database. A relative `file:` path is
# resolved against each process's working directory, which in a workspace means
# `apps/web/sequent.db` and `apps/engine/sequent.db` — two different venues that
# look identical until nothing lines up.
#
# `scripts/dev.js` and `scripts/seed.js` resolve this against the workspace root
# before spawning anything, so a relative path is safe when you start things
# through them. Starting a process by hand is when it bites.
#
# Production: a Turso URL, e.g. libsql://sequent-you.turso.io
DATABASE_URL="file:sequent.db"

# --- Web ---------------------------------------------------------------------
#
# Where the app is served from, and the origin every state-changing cookie
# request is checked against in `hooks.server.ts`.
#
# Read at BUILD time by `vite.config.ts` and baked into the adapter output by
# adapter-node v6. Changing it needs a rebuild, not a restart — and when it is
# absent the adapter reconstructs an origin from the Host header assuming https,
# so a plain-HTTP preview computes the wrong one and every POST returns 403.
PUBLIC_ORIGIN="http://localhost:5173"

# --- Worker ------------------------------------------------------------------
#
# Identifies which worker holds an outbox lease. Any string; it only has to be
# unique per process, and it is what `leased_by` records when you are trying to
# work out which machine is sitting on a stuck message.
WORKER_NAME=""

# Loosens the webhook SSRF checks so you can point an endpoint at
# `http://localhost:3000` and watch a delivery arrive.
#
# It permits http and private addresses. It does NOT permit link-local
# (169.254.0.0/16) — the cloud metadata service lives there, and an escape hatch
# for local development has no business opening the single most valuable SSRF
# target there is. Never set this outside your own machine.
ALLOW_INSECURE_WEBHOOKS="false"

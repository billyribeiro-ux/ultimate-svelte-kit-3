{
	// The WebWorker lib instead of the DOM one, and `$app/types` for the generated
	// route and asset types. Generated by SvelteKit; extended rather than copied.
	//
	// A project of its own, in the worker's own folder, because a worker's
	// `fetch` event is a `FetchEvent` with `respondWith` and the DOM's is not,
	// and one tsconfig cannot hold both libraries. The root `tsconfig.json`
	// excludes `src/service-worker` so that the two never see the same file.
	"extends": "$app/tsconfig/service-worker",
	"compilerOptions": {
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true
	},
	"include": ["./**/*.ts"]
}

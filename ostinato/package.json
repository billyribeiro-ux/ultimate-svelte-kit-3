{
	"name": "ostinato",
	"description": "Ostinato — a groovebox in the browser: a step sequencer, synthesized instruments, published patterns, live jam rooms and an embeddable player.",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"engines": {
		"node": ">=24.21.0"
	},
	"packageManager": "pnpm@12.10.1",
	"scripts": {
		"dev": "pnpm run build:embed && vite dev",
		"build": "pnpm run build:embed && vite build",
		"preview": "vite preview",
		"start": "node build/index.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --compiler-warnings \"options_missing_custom_element:ignore\" && tsc --noEmit -p src/service-worker/tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "pnpm run test:unit --run && pnpm run test:e2e",
		"test:e2e": "playwright test",
		"verify": "pnpm run check && pnpm run lint && pnpm run test:unit --run && pnpm run build && pnpm run test:e2e",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:seed": "node scripts/seed.ts",
		"build:embed": "vite build --config vite.embed.config.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^24.19.2",
		"@vitest/browser-playwright": "^5.0.3",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"playwright": "^1.64.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"rolldown": "^1.2.13",
		"sirv": "^3.0.2",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.1",
		"vite": "^8.3.4",
		"vitest": "^5.0.3",
		"vitest-browser-svelte": "^3.1.0"
	},
	"dependencies": {
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/outfit": "^5.3.0",
		"@libsql/client": "^0.18.0",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/core": "^2.12.0",
		"@opentelemetry/sdk-trace-base": "^2.12.0",
		"@opentelemetry/sdk-trace-node": "^2.12.0",
		"drizzle-orm": "^0.45.4",
		"gsap": "^3.15.0",
		"phosphor-svelte": "^3.1.1",
		"valibot": "^1.5.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}

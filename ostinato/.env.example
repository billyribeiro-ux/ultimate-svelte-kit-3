# Ostinato — copy to `.env` and fill in.

# libSQL. A file for development; a Turso URL plus token in production.
DATABASE_URL=file:local.db

# Where the app is served from, with no trailing slash.
#
# Read at BUILD time as well as at run time (`static: true` in `src/env.ts`),
# because `vite.config.ts` substitutes it into `paths.origin` for the CSRF
# check. Set it for the build, not just for the process.
PUBLIC_ORIGIN=http://localhost:5173

# Signs the artist cookie — the one thing that says "this browser published
# that pattern". Generate with: openssl rand -base64 32
SESSION_SECRET=replace-me-with-at-least-thirty-two-characters

# How many recent server spans the diagnostics page keeps in memory.
TRACE_BUFFER=200

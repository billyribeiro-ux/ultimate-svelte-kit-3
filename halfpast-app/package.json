{
	"name": "halfpast-app",
	"description": "Halfpast — real-time appointment booking for independent studios, clinics and salons.",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"engines": {
		"node": ">=24.22.0"
	},
	"packageManager": "pnpm@12.14.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "node scripts/sync-fonts.js && (svelte-kit sync || echo '')",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "node scripts/prepare-e2e-db.js && playwright test",
		"verify": "npm run check && npm run lint && npm run test:unit -- --run && npm run build && npm run test:e2e",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:seed": "node scripts/seed.ts",
		"auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
		"fonts:sync": "node scripts/sync-fonts.js",
		"fonts:measure": "node scripts/measure-font-metrics.js"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^24.19.2",
		"@vitest/browser-playwright": "^5.0.5",
		"auth": "^1.7.10",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"playwright": "^1.64.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.5",
		"vitest-browser-svelte": "^3.1.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fontsource-variable/bricolage-grotesque": "^5.3.0",
		"@fontsource-variable/public-sans": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@libsql/client": "^0.18.0",
		"better-auth": "^1.7.10",
		"drizzle-orm": "^0.45.4",
		"gsap": "^3.15.0",
		"phosphor-svelte": "^3.1.1",
		"valibot": "^1.5.0"
	}
}

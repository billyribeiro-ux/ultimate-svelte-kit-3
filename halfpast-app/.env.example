# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
# Every name here must also be declared in `src/env.ts` or the app will not read it.

# --- Database (Drizzle + libSQL) ---
# Local development: a file next to the project.
# Production: a Turso URL, e.g. libsql://halfpast-you.turso.io
DATABASE_URL="file:local.db"

# Only needed for a remote libSQL database. Leave blank for a local file.
DATABASE_AUTH_TOKEN=""

# --- Server ---
# Where the server believes it lives. Must match the URL in the browser bar,
# or Better Auth will reject its own cookies.
ORIGIN="http://localhost:5173"

# --- Better Auth ---
# At least 32 characters of high entropy. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=""

# --- Public (these reach the browser — never put a secret here) ---
PUBLIC_ORIGIN="http://localhost:5173"

# The fallback time zone for visitors whose own we cannot detect.
PUBLIC_DEFAULT_TIME_ZONE="Europe/London"

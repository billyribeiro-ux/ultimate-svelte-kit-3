# Loaded by Vite when the mode is `test`, which Vitest sets. Committed on purpose:
# it holds nothing secret and every contributor's tests should run identically.
#
# The database is a real file rather than `:memory:` — an in-memory SQLite
# database is per-connection, and the whole point of the concurrency tests is to
# have several connections argue with each other over the same rows.
DATABASE_URL="file:.test.db"
DATABASE_AUTH_TOKEN=""

ORIGIN="http://localhost:4173"
BETTER_AUTH_SECRET="test-secret-not-used-for-anything-real-000000"

PUBLIC_ORIGIN="http://localhost:4173"
PUBLIC_DEFAULT_TIME_ZONE="Europe/London"

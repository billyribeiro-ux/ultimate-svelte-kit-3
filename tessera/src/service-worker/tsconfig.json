{
	// The WebWorker lib instead of the DOM one, and `$app/types` for the generated
	// route and asset types. Generated by SvelteKit; extended rather than copied.
	//
	// It lives here, next to the one file it governs, because that is where
	// SvelteKit 3 documents it: `src/service-worker/tsconfig.json` extending
	// `$app/tsconfig/service-worker`, with the directory excluded from the root
	// `tsconfig.json` so the worker is never checked against the DOM lib by
	// mistake. The `check` script runs `tsc` against this file explicitly, since
	// `svelte-check` only ever reads the root config.
	"extends": "$app/tsconfig/service-worker",
	"compilerOptions": {
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true
	},
	"include": ["./**/*.ts"]
}

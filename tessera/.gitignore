# Dependencies. Restored by `pnpm install` from the lockfile, which *is*
# committed — the lockfile is the source of truth, the folder is a cache.
node_modules/

# Build output.
/build
/.svelte-kit
.output
.vercel
.netlify
.wrangler

# Fonts are copied out of node_modules by `scripts/sync-fonts.js`. Committing
# them would mean two copies of the same bytes disagreeing after an upgrade.
/static/fonts/

# Databases and their write-ahead logs. Rebuilt by `pnpm run db:migrate`.
*.db
*.db-shm
*.db-wal

# Test and tooling caches.
test-results/
playwright-report/
coverage/
.vitest/
*.tsbuildinfo
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Local environment. `.env.example` is committed; the real one never is.
.env
.env.*
!.env.example

# Editors and operating systems.
.DS_Store
Thumbs.db
*.swp
.idea/

# Scratch files. Anything ending `.tmp.ts` is a throwaway probe.
*.tmp.ts

# Copy to `.env`. Every variable here is declared in `src/env.ts`; one that is
# not declared there cannot be imported, so this file and that file cannot drift.

# libSQL connection string. A local file in development, a Turso URL in production.
DATABASE_URL=file:local.db

# Where the app is served from, with no trailing slash.
#
# This is not decoration. SvelteKit compares it against the `Origin` header on
# every form POST and remote-function call, and adapter-node substitutes it at
# BUILD time. Get it wrong and every write returns 403 while every read works.
PUBLIC_ORIGIN=http://localhost:5173

# Signs session cookies. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# How long a board keeps its operation log before compaction runs, in days.
# Raising it costs storage; lowering it costs the tail of version history.
BOARD_LOG_RETENTION_DAYS=30

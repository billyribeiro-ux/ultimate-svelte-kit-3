{
	// The CSV import worker: the WebWorker library instead of the DOM one, so
	// that `self.postMessage` type-checks and `document` does not.
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"lib": ["ES2024", "WebWorker"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"types": []
	},
	"include": ["src/lib/csv/worker.ts", "src/lib/csv/protocol.ts", "src/lib/csv/parse.ts"]
}

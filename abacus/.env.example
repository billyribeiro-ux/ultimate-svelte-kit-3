# Abacus — copy to `.env` and fill in.

# libSQL. A file for development; a Turso URL plus token in production.
DATABASE_URL=file:local.db

# Where the app is served from, with no trailing slash.
#
# Read at BUILD time as well as at run time (`static: true` in `src/env.ts`):
# `vite.config.ts` substitutes it into `paths.origin` for the CSRF check, and
# the passkey ceremonies use its hostname as the relying-party id. Set it for
# the build, not just for the process.
PUBLIC_ORIGIN=http://localhost:5173

# Signs the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=replace-me-with-at-least-thirty-two-characters

# The largest sheet the server will store, in cells. Keeps one paste from
# turning the database into a swap file.
CELL_LIMIT=200000

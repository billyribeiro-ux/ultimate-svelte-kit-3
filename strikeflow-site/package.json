{
	"name": "strikeflow-site",
	"description": "Marketing site for StrikeFlow — real-time options flow intelligence.",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"engines": {
		"node": ">=24.21.0"
	},
	"packageManager": "pnpm@12.10.1",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"fonts:sync": "node scripts/sync-fonts.js",
		"prepare": "node scripts/sync-fonts.js && (svelte-kit sync || echo '')",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"ebook:build": "node scripts/build-ebook.js",
		"fonts:measure": "node scripts/measure-font-metrics.js"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^24.19.2",
		"@vitest/browser-playwright": "^5.0.3",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"playwright": "^1.64.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.1",
		"vite": "^8.3.4",
		"vitest": "^5.0.3",
		"vitest-browser-svelte": "^3.1.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fontsource-variable/montserrat": "^5.3.0",
		"@fontsource-variable/sofia-sans": "^5.3.0",
		"gsap": "^3.15.0",
		"lightweight-charts": "^5.2.1",
		"phosphor-svelte": "^3.1.1",
		"valibot": "^1.5.0"
	}
}

# Sextant — copy to `.env` and fill in.

# libSQL. A file for development; a Turso URL plus token in production.
DATABASE_URL=file:local.db

# Where the app is served from, with no trailing slash.
#
# Read at BUILD time as well as at run time (`static: true` in `src/env.ts`),
# because `vite.config.ts` substitutes it into `paths.origin` for the CSRF
# check. Set it for the build, not just for the process.
PUBLIC_ORIGIN=http://localhost:5173

# Signs session cookies. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-at-least-thirty-two-characters

# Limits. Every one of these exists so that a flood of telemetry becomes a
# refusal with a Retry-After rather than an outage. See `src/env.ts`.
INGEST_MAX_BATCH=5000
INGEST_RATE_PER_MINUTE=600000
SERIES_CARDINALITY_LIMIT=10000
RETENTION_DAYS=14

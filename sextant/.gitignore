node_modules
/build
/.svelte-kit
.env

# Databases. `*.db` covers `local.db` and the throwaway `e2e.db`; the `-shm` and
# `-wal` siblings exist because the connection runs in WAL mode.
*.db
*.db-journal
*.db-shm
*.db-wal

# End-to-end artefacts, including the stored session cookie the setup project
# writes. A committed session cookie is a committed credential.
/e2e/.auth
/test-results
/playwright-report
